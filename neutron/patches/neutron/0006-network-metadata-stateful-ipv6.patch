+from alembic import op
+import sqlalchemy as sa
+
+# Add the ``networkmetadatastatefulipv6`` table, used by the
+# ``network-metadata-stateful-ipv6`` API extension to store the networks with
+# a metadata port address on their stateful IPv6 subnets.
+#
+# Revision ID: b5d2f8c3a7e1
+# Revises: 8c4e1f7a2b90
+# Create Date: 2026-11-02 10:00:00.000000
+
+revision = 'b5d2f8c3a7e1'
+down_revision = '8c4e1f7a2b90'
+
+
+def upgrade():
+    op.create_table(
+        'networkmetadatastatefulipv6',
+        sa.Column('network_id', sa.String(length=36), nullable=False),
+        sa.Column('enabled', sa.Boolean(), nullable=False),
+        sa.ForeignKeyConstraint(['network_id'], ['networks.id'],
+                                ondelete='CASCADE'),
+        sa.PrimaryKeyConstraint('network_id'),
+    )
