@@ -650,6 +650,22 @@ class SbAPI(api.API, metaclass=abc.ABCMeta):
         value. And hostname and physnets are related to the same host.
         """
 
+    @abc.abstractmethod
+    def get_evpn_gateway_chassis(self):
+        """Get the names of the chassis that can host EVPN router ports.
+
+        An EVPN router port needs the EVPN pieces on the chassis it is bound
+        to (the OVN agent's ovn-evpn extension and a BGP speaker), which not
+        every gateway chassis has. Chassis marked with
+
+        ovs-vsctl set open .
+           external_ids:ovn-cms-options="enable-chassis-as-evpn-gw"
+
+        are returned when there is at least one; otherwise every gateway
+        chassis (enable-chassis-as-gw) is returned, as before this option
+        existed.
+        """
+
     @abc.abstractmethod
     def get_gateway_chassis_from_cms_options(self, name_only=True):
         """Get chassis eligible for external connectivity from CMS options.
diff --git a/neutron/plugins/ml2/drivers/ovn/mech_driver/ovsdb/impl_idl_ovn.py b/neutron/plugins/ml2/drivers/ovn/mech_driver/ovsdb/impl_idl_ovn.py
index 90a211260f..5be95fe29c 100644
--- a/neutron/plugins/ml2/drivers/ovn/mech_driver/ovsdb/impl_idl_ovn.py
+++ b/neutron/plugins/ml2/drivers/ovn/mech_driver/ovsdb/impl_idl_ovn.py
@@ -1056,6 +1056,14 @@ class OvsdbSbOvnIdl(sb_impl_idl.OvnSbApiIdlImpl, Backend):
                 for ch in self.chassis_list().execute(check_error=True)
                 if utils.is_gateway_chassis(ch)]
 
+    def get_evpn_gateway_chassis(self):
+        chassis = self.chassis_list().execute(check_error=True)
+        evpn_gw = [ch.name for ch in chassis
+                   if utils.is_evpn_gateway_chassis(ch)]
+        if evpn_gw:
+            return evpn_gw
+        return [ch.name for ch in chassis if utils.is_gateway_chassis(ch)]
+
     def get_extport_chassis_from_cms_options(self):
         return [ch for ch in self.chassis_list().execute(check_error=True)
                 if utils.is_extport_host_chassis(ch)]
