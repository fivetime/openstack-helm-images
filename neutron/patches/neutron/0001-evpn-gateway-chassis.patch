+def is_evpn_gateway_chassis(chassis):
+    """Check if the given Chassis is marked to host EVPN router ports"""
+    return (constants.CMS_OPT_CHASSIS_AS_EVPN_GW in
+            get_ovn_cms_options(chassis))
