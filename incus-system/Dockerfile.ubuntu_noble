# Operator-owned base for Incus OCI SYSTEM images (contract
# incus-oci-system-v1). Nova never runs this as an application container:
# tools/publish-incus-oci-system-image.py in fivetime/nova-incus-driver
# flattens it into an ordinary Incus system image for Glance. Derived images
# FROM this one by digest, enable their services with systemctl and keep its
# CMD, user, working directory and environment; see that repository's
# doc/source/oci_system_images.rst.
FROM docker.io/library/ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac

LABEL org.opencontainers.image.title="Incus system base (Ubuntu 24.04)" \
      org.opencontainers.image.description="systemd, cloud-init, sshd, netplan and fuse2fs for Nova Incus system containers; publish through the incus-oci-system-v1 normalizer, never run as an application" \
      org.opencontainers.image.source="https://github.com/fivetime/openstack-helm-images" \
      org.opencontainers.image.base.name="docker.io/library/ubuntu:24.04" \
      org.opencontainers.image.base.digest="sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac" \
      io.fivetime.incus.image-contract="incus-oci-system-v1"

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      systemd systemd-sysv cloud-init openssh-server iproute2 netplan.io \
      systemd-resolved fuse2fs fuse3 ca-certificates python3 sudo \
      lsb-release curl \
    && systemctl enable cloud-init-local.service cloud-init.service \
         cloud-config.service cloud-final.service ssh.service \
    && rm -f /etc/ssh/ssh_host_* /etc/machine-id /var/lib/dbus/machine-id \
    && rm -rf /var/lib/cloud/* /var/lib/apt/lists/* \
    && touch /etc/machine-id

CMD ["/sbin/init"]
