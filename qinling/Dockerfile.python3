# syntax=docker/dockerfile:1
# The python3 runtime of Qinling, built from runtimes/python3 of the fork
# (fivetime/openstack-qinling), which also has a Dockerfile for local builds;
# keep the two alike.
ARG GIT_IMAGE=docker.io/library/alpine:3.22
ARG PYTHON_IMAGE=docker.io/library/python:3.14-slim

FROM ${GIT_IMAGE} AS src
ARG QINLING_REPO=https://github.com/fivetime/openstack-qinling
ARG QINLING_REF=17.2.3
# The repository is private: CI supplies src_repo_token as a BuildKit
# secret, used only inside this RUN and this stage.
RUN --mount=type=secret,id=src_repo_token \
    apk add --no-cache git \
    && if [ -s /run/secrets/src_repo_token ]; then \
        git config --global \
          url."https://x-access-token:$(cat /run/secrets/src_repo_token)@github.com/".insteadOf \
          "https://github.com/"; \
    fi \
    && git clone --filter=blob:none ${QINLING_REPO} /src \
    && git -C /src checkout --detach ${QINLING_REF} \
    && rm -f /root/.gitconfig \
    && git -C /src log --oneline -1 > /src/project.txt

FROM ${PYTHON_IMAGE}
# The libraries follow the 2026.2 upper constraints, like the services.
ARG UPPER_CONSTRAINTS=https://releases.openstack.org/constraints/upper/2026.2
ADD ${UPPER_CONSTRAINTS} /app/upper-constraints.txt
COPY --from=src /src/project.txt /etc/qinling-runtime-project.txt

RUN useradd -mrs /usr/sbin/nologin -u 42480 qinling

COPY --from=src /src/runtimes/python3/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -c /app/upper-constraints.txt -r /app/requirements.txt \
    && pip freeze > /app/pip.txt

COPY --from=src /src/runtimes/python3/server.py /app/server.py
# Hands executions to the worker where the engine cannot reach it (Zun).
COPY --from=src /src/runtimes/python3/qinling-invoke /usr/local/bin/qinling-invoke
RUN mkdir -p /var/qinling/packages && \
    chown qinling:qinling /var/qinling/packages

WORKDIR /app
USER qinling
EXPOSE 9090

# Zun containers listen on 127.0.0.1 only (QINLING_WORKER_BIND) and run
# fewer processes (QINLING_WORKER_PROCESSES).
CMD ["sh", "-c", "exec gunicorn --bind ${QINLING_WORKER_BIND:-0.0.0.0}:9090 \
--workers ${QINLING_WORKER_PROCESSES:-5} --timeout 0 --access-logfile - server:app"]
