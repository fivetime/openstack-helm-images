# syntax=docker/dockerfile:1
# Add the reviewed Incus reservation protocol to the exact deployed Cinder.
ARG CINDER_BASE=ghcr.io/fivetime/openstackhelm/cinder@sha256:00acbe9904fe0a9240b6ed7ad6e45e514a59dc227ab7a268613c22a345849d45
FROM ${CINDER_BASE}

USER root
ARG NOVA_INCUS_REPO=https://github.com/fivetime/nova-incus-driver.git
ARG NOVA_INCUS_REF=1fd037c4794cbc46bc1448b948d887ff215591de

RUN --mount=type=secret,id=src_repo_token \
    grep -q d884fdaeb78cc9fcd331cc9426844d0ef2d9890e /etc/image_info/project.txt \
 && apk add --no-cache --virtual .incus-patch-tools git \
 && if [ -s /run/secrets/src_repo_token ]; then \
        token="$(cat /run/secrets/src_repo_token)"; \
        git config --global \
          url."https://x-access-token:${token}@github.com/".insteadOf \
          "https://github.com/"; \
    fi \
 && git init /tmp/incus-cinder-patches \
 && git -C /tmp/incus-cinder-patches remote add origin "${NOVA_INCUS_REPO}" \
 && git -C /tmp/incus-cinder-patches fetch --depth=1 origin "${NOVA_INCUS_REF}" \
 && git -C /tmp/incus-cinder-patches checkout --detach FETCH_HEAD \
 && rm -f /root/.gitconfig \
 && cinder_site="$(python3 -c 'import pathlib, cinder; print(pathlib.Path(cinder.__file__).parent.parent)')" \
 && cd "${cinder_site}" \
 && git apply --check --exclude='cinder/tests/**' \
        /tmp/incus-cinder-patches/patches/cinder/attachment-request-idempotency.patch \
 && git apply --exclude='cinder/tests/**' \
        /tmp/incus-cinder-patches/patches/cinder/attachment-request-idempotency.patch \
 && python3 -m compileall -q cinder \
 && printf 'nova-incus-cinder-patches %s\n' "${NOVA_INCUS_REF}" >> /etc/image_info/project.txt \
 && sha256sum /tmp/incus-cinder-patches/patches/cinder/attachment-request-idempotency.patch \
        > /etc/image_info/incus-cinder-patch.sha256 \
 && rm -rf /tmp/incus-cinder-patches \
 && apk del .incus-patch-tools

CMD ["cinder-api"]
