# syntax=docker/dockerfile:1

FROM alpine:3.23 AS source

ARG NOVA_INCUS_REPO=https://github.com/fivetime/nova-incus-driver.git
ARG NOVA_INCUS_REF=866d7e20a82e0a8502dc84e8822bc840eae07ec0

RUN apk add --no-cache git
RUN --mount=type=secret,id=src_repo_token \
    if [ -s /run/secrets/src_repo_token ]; then \
        token="$(cat /run/secrets/src_repo_token)"; \
        git config --global \
          url."https://x-access-token:${token}@github.com/".insteadOf \
          "https://github.com/"; \
    fi \
 && git init /src \
 && git -C /src remote add origin "${NOVA_INCUS_REPO}" \
 && git -C /src fetch --depth=1 --filter=blob:none origin "${NOVA_INCUS_REF}" \
 && git -C /src checkout --detach FETCH_HEAD \
 && rm -f /root/.gitconfig

# Pinned by digest: the release tag is mutable and must not silently pull a
# newer Nova build while this image only adds the Incus RPC object registry
# and the control-plane patches. Our CI's nova:2026.2-ubuntu_resolute as of
# 2026-10-16 (openstack-helm-images f12b5f6): Nova stable/2026.2 8df1922926
# with nova/patches/nova/2026.2 (osprofiler tracing decided after the config
# is parsed), Ubuntu 26.04.1, Python 3.14.4, with osprofiler, the
# OpenTelemetry exporter and the osprofiler-otlp patches (it replaces
# quay.io/airshipit/nova, which carries no osprofiler).
FROM ghcr.io/fivetime/openstackhelm/nova@sha256:4fde9774f4150226bd79478be4e798d9a4f8a3eebef64f1c98ad9ef7aa23af2f

ARG SITE_PACKAGES=/var/lib/openstack/lib/python3.14/site-packages

COPY --from=source /src/nova/virt/incus/__init__.py \
    ${SITE_PACKAGES}/nova/virt/incus/__init__.py
COPY --from=source /src/nova/virt/incus/migrate_data.py \
    ${SITE_PACKAGES}/nova/virt/incus/migrate_data.py
COPY --from=source /src/patches/nova/0002-hardware-accept-incus-manila-share-trait.patch \
    /tmp/0002-hardware-accept-incus-manila-share-trait.patch
COPY --from=source /src/patches/nova/2026.2/0003-compute-allow-incus-manila-live-migration.patch \
    /tmp/0003-compute-allow-incus-manila-live-migration.patch
COPY --from=source /src/patches/nova/2026.2/0006-sdk-user-token-honor-service-config.patch \
    /tmp/0006-sdk-user-token-honor-service-config.patch
COPY --from=source /src/patches/nova/0008-compute-allow-container-bfv-rescue.patch \
    /tmp/0008-compute-allow-container-bfv-rescue.patch
COPY --from=source /src/patches/nova/0009-compute-api-refuse-evacuate-during-rebuild.patch \
    /tmp/0009-compute-api-refuse-evacuate-during-rebuild.patch

RUN cd "${SITE_PACKAGES}" \
 && test -f nova/compute/share_management.py \
 && git apply --no-index \
      --include=nova/virt/hardware.py \
      /tmp/0002-hardware-accept-incus-manila-share-trait.patch \
 && git apply --no-index \
      --include=nova/api/openstack/compute/server_shares.py \
      --include=nova/compute/api.py \
      --include=nova/compute/manager.py \
      --include=nova/compute/share_management.py \
      /tmp/0003-compute-allow-incus-manila-live-migration.patch \
 && git apply --no-index \
      --include=nova/utils.py \
      /tmp/0006-sdk-user-token-honor-service-config.patch \
 && git apply --no-index \
      --include=nova/compute/api.py \
      /tmp/0008-compute-allow-container-bfv-rescue.patch \
 && git apply --no-index \
      --include=nova/compute/api.py \
      /tmp/0009-compute-api-refuse-evacuate-during-rebuild.patch \
 && rm -f /tmp/0002-hardware-accept-incus-manila-share-trait.patch \
      /tmp/0003-compute-allow-incus-manila-live-migration.patch \
      /tmp/0006-sdk-user-token-honor-service-config.patch \
      /tmp/0008-compute-allow-container-bfv-rescue.patch \
      /tmp/0009-compute-api-refuse-evacuate-during-rebuild.patch

RUN python3 - "${SITE_PACKAGES}" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1]) / 'nova/objects/__init__.py'
source = path.read_text()
statement = "    __import__('nova.virt.incus.migrate_data')\n"
anchor = "    __import__('nova.objects.migrate_data')\n"
if statement not in source:
    if source.count(anchor) != 1:
        raise RuntimeError('Nova object registration anchor is not unique')
    source = source.replace(anchor, statement + anchor)
    path.write_text(source)
PY

RUN python3 - <<'PY'
import inspect

from nova.compute import api
from nova.compute import manager
from nova import objects
from nova import utils
from nova.objects import base
from nova.virt import hardware

objects.register_all()
print('base image:', open('/etc/image_info/project.txt').read().strip())
versions = base.NovaObjectRegistry.obj_classes().get('IncusLiveMigrateData', [])
assert versions and versions[0].VERSION == '1.7', versions
assert 'CUSTOM_INCUS_MANILA_SHARE' in inspect.getsource(
    hardware.check_shares_supported)
assert 'CUSTOM_INCUS_MANILA_LIVE_MIGRATION' in inspect.getsource(
    api.API.live_migrate)
assert hasattr(manager.ComputeManager, '_prepare_live_migration_check_data')
assert hasattr(manager.ComputeManager, '_complete_live_migration_rollback')
assert 'oslo_conf=CONF' in inspect.getsource(utils.get_sdk_adapter)
assert 'CUSTOM_INCUS_SYSTEM_CONTAINER' in inspect.getsource(api.API.rescue)
assert 'rebuild_states' in inspect.getsource(api.API.evacuate)
print('Nova Incus control-plane migrate-data 1.7 OK')
print('Nova Incus control-plane Manila migration contract OK')
print('Nova user-token SDK service configuration OK')
print('Nova evacuate rebuild-state refusal OK')

# Tracing comes with the base image: osprofiler's otlp driver and the RPC
# context cleanup from osprofiler-otlp/ (patched in nova/Dockerfile's build).
from nova import thread_pool_factory
from oslo_messaging.rpc import dispatcher
import osprofiler.drivers.otlp as otlp
assert hasattr(otlp.OTLP, '_reset_after_fork')
assert 'profiler.clean()' in inspect.getsource(
    dispatcher.RPCDispatcher._do_dispatch)
assert 'profiler.clean()' in inspect.getsource(thread_pool_factory.spawn_on)
from nova import profiler as nova_profiler
from nova import service as nova_service
assert hasattr(nova_profiler, 'enable_tracing')
assert 'enable_tracing()' in inspect.getsource(nova_service.setup_profiler)
print('osprofiler otlp driver, RPC trace cleanup and deferred tracing OK')
PY
