# syntax=docker/dockerfile:1

FROM alpine:3.23 AS source

ARG NOVA_INCUS_REPO=https://github.com/fivetime/nova-incus-driver.git
ARG NOVA_INCUS_REF=b0970dc4fb9817743035bbb0973af1cf529f256b

RUN apk add --no-cache git
RUN --mount=type=secret,id=src_repo_token \
    if [ -s /run/secrets/src_repo_token ]; then \
        token="$(cat /run/secrets/src_repo_token)"; \
        git config --global \
          url."https://x-access-token:${token}@github.com/".insteadOf \
          "https://github.com/"; \
    fi \
 && git init /src \
 && git -C /src remote add origin "${NOVA_INCUS_REPO}" \
 && git -C /src fetch --depth=1 --filter=blob:none origin "${NOVA_INCUS_REF}" \
 && git -C /src checkout --detach FETCH_HEAD \
 && rm -f /root/.gitconfig

# Keep the control-plane runtime identical to the image already qualified in
# production. The Airship release tag is mutable and must not silently pull a
# newer Nova build while this image only adds the Incus RPC object registry.
FROM quay.io/airshipit/nova@sha256:084ca5611eb34c33d1922e09c4baca079e180971fef509e0a307270ac638e1af

COPY --from=source /src/nova/virt/incus/__init__.py \
    /var/lib/openstack/lib/python3.12/site-packages/nova/virt/incus/__init__.py
COPY --from=source /src/nova/virt/incus/migrate_data.py \
    /var/lib/openstack/lib/python3.12/site-packages/nova/virt/incus/migrate_data.py
COPY --from=source /src/patches/nova/0002-hardware-accept-incus-manila-share-trait.patch \
    /tmp/0002-hardware-accept-incus-manila-share-trait.patch
COPY --from=source /src/patches/nova/0003-compute-allow-incus-manila-live-migration.patch \
    /tmp/0003-compute-allow-incus-manila-live-migration.patch
COPY --from=source /src/patches/nova/0006-sdk-user-token-honor-service-config.patch \
    /tmp/0006-sdk-user-token-honor-service-config.patch

RUN cd /var/lib/openstack/lib/python3.12/site-packages \
 && git apply --no-index \
      --include=nova/virt/hardware.py \
      /tmp/0002-hardware-accept-incus-manila-share-trait.patch \
 && git apply --no-index \
      --include=nova/api/openstack/compute/server_shares.py \
      --include=nova/compute/api.py \
      --include=nova/compute/manager.py \
      /tmp/0003-compute-allow-incus-manila-live-migration.patch \
 && git apply --no-index \
      --include=nova/utils.py \
      /tmp/0006-sdk-user-token-honor-service-config.patch \
 && rm -f /tmp/0002-hardware-accept-incus-manila-share-trait.patch \
      /tmp/0003-compute-allow-incus-manila-live-migration.patch \
      /tmp/0006-sdk-user-token-honor-service-config.patch

RUN python3 - <<'PY'
from pathlib import Path

path = Path('/var/lib/openstack/lib/python3.12/site-packages/nova/objects/__init__.py')
source = path.read_text()
statement = "    __import__('nova.virt.incus.migrate_data')\n"
anchor = "    __import__('nova.objects.migrate_data')\n"
if statement not in source:
    if source.count(anchor) != 1:
        raise RuntimeError('Nova object registration anchor is not unique')
    source = source.replace(anchor, statement + anchor)
    path.write_text(source)
PY

RUN python3 - <<'PY'
import inspect

from nova.compute import api
from nova.compute import manager
from nova import objects
from nova import utils
from nova.objects import base
from nova.virt import hardware

objects.register_all()
versions = base.NovaObjectRegistry.obj_classes().get('IncusLiveMigrateData', [])
assert versions and versions[0].VERSION == '1.6', versions
assert 'CUSTOM_INCUS_MANILA_SHARE' in inspect.getsource(
    hardware.check_shares_supported)
assert 'CUSTOM_INCUS_MANILA_LIVE_MIGRATION' in inspect.getsource(
    api.API.live_migrate)
assert hasattr(manager.ComputeManager, '_prepare_live_migration_check_data')
assert hasattr(manager.ComputeManager, '_complete_live_migration_rollback')
assert 'oslo_conf=CONF' in inspect.getsource(utils.get_sdk_adapter)
print('Nova Incus control-plane migrate-data 1.6 OK')
print('Nova Incus control-plane Manila migration contract OK')
print('Nova user-token SDK service configuration OK')
PY
